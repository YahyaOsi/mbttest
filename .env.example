# Copy to .env privately. These are placeholders, never production credentials.
# The Node services do not auto-load .env; export it in your shell before running.

# Required PostgreSQL connection; replace DB_USER/DB_PASSWORD with local credentials.
DATABASE_URL='postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/sentinel'
# API listen port; override to 5173 for the separate Vite process.
PORT=8080
# Frontend deployment base path, normally / on an external host.
BASE_PATH=/
# Node execution environment; production for built deployments.
NODE_ENV=development
# Structured server logging level.
LOG_LEVEL=info
# Read-only safety switch: true disables the automatic trading/AI background worker.
SENTINEL_READ_ONLY=true
# Explicit mainnet signing permission: keep false until independently audited.
ENABLE_MAINNET_TRADING=false
# Owner attestation that the deployment is continuously available; not a scheduler.
SENTINEL_ALWAYS_ON_CONFIRMED=false
# New private owner-console password, 16–256 characters; leave blank to keep console locked.
SENTINEL_APP_PASSWORD=''
# New random session/encryption secret, at least 32 characters; never reuse a shared example.
SESSION_SECRET=''
# Optional owner namespace; changing it does not migrate old wallet-bound positions.
SENTINEL_OWNER_USER_ID=sentinel-owner
# Optional single mainnet RPC, used only when numbered RPC_URL_* variables are absent.
SOLANA_RPC_URL=''
# Secondary/background RPC slot 1; blank means not configured.
RPC_URL_1=''
# Secondary/background RPC slot 2; blank means not configured.
RPC_URL_2=''
# Primary slot when at least 3 distinct endpoints are configured; swaps/reconciliation use primary.
RPC_URL_3=''
# Optional background/read-failover endpoint slot 4.
RPC_URL_4=''
# Optional background/read-failover endpoint slot 5.
RPC_URL_5=''
# Optional background/read-failover endpoint slot 6.
RPC_URL_6=''
# Server-only dedicated burner keypair, base58 or 64-byte JSON; NEVER enter a recovery phrase.
SOLANA_TRADING_PRIVATE_KEY=''
# Jupiter API credential for authenticated token/quote/swap APIs.
JUPITER_API_KEY=''
# OpenAI-compatible service base URL; outside Replit supply your own supported provider.
AI_INTEGRATIONS_OPENAI_BASE_URL='https://api.openai.com/v1'
# Placeholder allows client construction only; it is NOT a usable AI credential.
AI_INTEGRATIONS_OPENAI_API_KEY='offline-placeholder'
# Optional legacy Clerk server credential; owner-password console does not require Clerk.
CLERK_SECRET_KEY=''
# Optional Replit tooling identifier; leave blank outside Replit to avoid platform tooling.
# REPL_ID=''
# Legacy Clerk publishable keys are not referenced by current app source; not required.
# CLERK_PUBLISHABLE_KEY=''
# VITE_CLERK_PUBLISHABLE_KEY=''
# Vite provides import.meta.env.BASE_URL from BASE_PATH; do not configure BASE_URL separately.
# Vite provides import.meta.env.DEV automatically from its development/build mode.
